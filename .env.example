# Engine settings. Copy to .env and fill in. Keep comments on their own lines:
# the server's systemd service reads "KEY=value # note" as the value "value # note".

# ── Zerodha Kite Connect (developers.kite.trade) ─────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=

# Only needed when Supabase is NOT configured (local runs without the website).
# With Supabase set, the engine takes the daily token from the website's
# "Log in to Kite" button instead.
KITE_ACCESS_TOKEN=

# ── Supabase + website ───────────────────────────────────────────────────────
# Same project URL and secret (service_role) key as the Vercel site. With both
# set, every signal is saved for the website and the Kite token comes from it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# The website address, linked from "Kite login needed" Discord reminders.
SITE_URL=

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Instrument universe ──────────────────────────────────────────────────────
# SCAN_NIFTY500=true takes priority; SCAN_FULL_NSE=true scans every NSE EQ
# instrument; with both false, only INSTRUMENT_TOKENS (comma-separated) is used.
SCAN_NIFTY500=true
SCAN_FULL_NSE=false
INSTRUMENT_TOKENS=

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_PATH=market_data.db
# Years of daily history kept. The 15:45 rollup deletes anything older.
RETENTION_YEARS=10

# ── Performance ──────────────────────────────────────────────────────────────
WORKER_POOL_SIZE=50
TICK_CHANNEL_CAPACITY=50000
